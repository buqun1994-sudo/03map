<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.autonavi.amapauto.content</groupId>
  <artifactId>content-host-probe</artifactId>
  <version>1</version>
  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <content.dependencies>${project.basedir}/../../.tmp/content-runtime-deps</content.dependencies>
  </properties>
  <repositories>
    <repository><id>google</id><url>https://dl.google.com/dl/android/maven2/</url></repository>
  </repositories>
  <dependencies>
    <dependency><groupId>org.robolectric</groupId><artifactId>robolectric</artifactId><version>4.14.1</version><scope>test</scope></dependency>
    <dependency><groupId>org.robolectric</groupId><artifactId>android-all</artifactId><version>10-robolectric-5803371</version><scope>provided</scope></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
    <dependency><groupId>local</groupId><artifactId>lottie</artifactId><version>6.6.7</version><scope>system</scope><systemPath>${content.dependencies}/lottie.jar</systemPath></dependency>
    <dependency><groupId>local</groupId><artifactId>core</artifactId><version>1.9.0</version><scope>system</scope><systemPath>${content.dependencies}/core.jar</systemPath></dependency>
    <dependency><groupId>local</groupId><artifactId>collection</artifactId><version>1.2.0</version><scope>system</scope><systemPath>${content.dependencies}/collection-1.2.0.jar</systemPath></dependency>
    <dependency><groupId>local</groupId><artifactId>okio</artifactId><version>1.17.6</version><scope>system</scope><systemPath>${content.dependencies}/okio-1.17.6.jar</systemPath></dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.basedir}/../../source/amap-9.5.0.600013/content-src</sourceDirectory>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version>
        <configuration>
          <includes><include>**/*Probe.java</include></includes>
          <additionalClasspathElements>
            <additionalClasspathElement>${content.dependencies}/monitor.jar</additionalClasspathElement>
            <additionalClasspathElement>${content.dependencies}/espresso-idling-resource.jar</additionalClasspathElement>
          </additionalClasspathElements>
          <systemPropertyVariables>
            <robolectric.dependency.repo.url>https://repo.maven.apache.org/maven2</robolectric.dependency.repo.url>
            <golden.apk>${golden.apk}</golden.apk>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
