<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:startColor="#040c1d" android:endColor="#010613" android:angle="90.0" android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap android:gravity="center|bottom" android:src="@drawable/earth" />
    </item>
    <item android:bottom="@dimen/auto_dimen2_210">
        <bitmap android:gravity="center" android:src="@drawable/slogan" />
    </item>
    <item android:left="@dimen/auto_dimen2_32" android:bottom="@dimen/auto_dimen2_16">
        <bitmap android:gravity="left|bottom" android:src="@drawable/amap_logo" />
    </item>
    <item android:right="@dimen/auto_dimen2_27" android:bottom="@dimen/auto_dimen2_20">
        <bitmap android:gravity="right|bottom" android:src="@drawable/copyright" />
    </item>
</layer-list>
